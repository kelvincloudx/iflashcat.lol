---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingSection from '../components/PricingSection.astro';
import TrafficCompare from '../components/TrafficCompare.astro';
import UserConcerns from '../components/UserConcerns.astro';
import { siteConfig } from '../data/site';

const pageTitle = '闪电猫 SpeedCAT 套餐参考价格表与付款周期说明｜iflashcat.lol';
const pageDescription = '完整汇总闪电猫 SpeedCAT 7 种公开参考套餐（迷你猫、闪电猫、霹雳猫、雷神猫、特惠年付小包、流星猫、飞天猫）共 19 个价格选项，包含月度重置与年度总流量核算。';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: '首页',
      item: 'https://iflashcat.lol/'
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: '套餐价格',
      item: 'https://iflashcat.lol/pricing/'
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/pricing/"
  jsonLd={breadcrumbSchema}
>
  <div class="page-header-banner">
    <div class="container">
      <nav class="breadcrumb" aria-label="路径导航">
        <a href="/">首页</a>
        <span class="breadcrumb-separator">/</span>
        <span class="current-crumb">套餐价格</span>
      </nav>
      <h1 class="page-title">闪电猫 SpeedCAT 套餐价格与方案详情</h1>
      <p class="page-subtitle">
        全面了解 7 种公开参考套餐规格，核对全部 19 个价格选项的支付周期与流量规则，理性规划订阅预算。
      </p>
    </div>
  </div>

  <!-- Pricing Table and Interactive Switcher -->
  <PricingSection showTitle={false} />

  <!-- Traffic Reset vs Annual Total Traffic Explanation -->
  <TrafficCompare />

  <!-- Rational Purchase Checklist -->
  <UserConcerns />
</BaseLayout>

<style>
  .page-header-banner {
    background: linear-gradient(135deg, #0F172A 0%, #1E1B4B 100%);
    color: #FFFFFF;
    padding: 60px 0 50px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    color: #94A3B8;
    margin-bottom: 20px;
  }

  .breadcrumb a {
    color: #CBD5E1;
  }

  .breadcrumb a:hover {
    color: var(--color-electric-cyan);
  }

  .current-crumb {
    color: #FFFFFF;
    font-weight: 600;
  }

  .page-title {
    font-size: 2.4rem;
    font-weight: 800;
    color: #FFFFFF;
    margin-bottom: 14px;
  }

  .page-subtitle {
    font-size: 1.1rem;
    color: #CBD5E1;
    max-width: 780px;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 1.8rem;
    }
    .page-subtitle {
      font-size: 0.95rem;
    }
  }
</style>
