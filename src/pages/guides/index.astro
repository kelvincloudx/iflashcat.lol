---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCardList from '../../components/ArticleCardList.astro';
import ClientSetupEntry from '../../components/ClientSetupEntry.astro';
import { siteConfig } from '../../data/site';

const pageTitle = '闪电猫 SpeedCAT 使用教程与配置指南专栏｜iflashcat.lol';
const pageDescription = '查阅闪电猫 SpeedCAT 全套原创使用指南，涵盖首次选购核实、付款周期比较、客户端订阅管理、多设备兼容、代理规则配置与网络连接排查。';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: '首页',
      item: 'https://iflashcat.lol/'
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: '使用教程',
      item: 'https://iflashcat.lol/guides/'
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/guides/"
  jsonLd={breadcrumbSchema}
>
  <div class="page-header-banner">
    <div class="container">
      <nav class="breadcrumb" aria-label="路径导航">
        <a href="/">首页</a>
        <span class="breadcrumb-separator">/</span>
        <span class="current-crumb">使用教程</span>
      </nav>
      <h1 class="page-title">闪电猫 SpeedCAT 知识与配置专栏</h1>
      <p class="page-subtitle">
        专为闪电猫用户打造的体系化图文指南，涵盖方案核实、计费周期换算、订阅安全、多端适配、分流规则与疑难排查。
      </p>
    </div>
  </div>

  <!-- Articles List -->
  <ArticleCardList showTitle={false} />

  <!-- Client Setup Entry Points -->
  <ClientSetupEntry />
</BaseLayout>

<style>
  .page-header-banner {
    background: linear-gradient(135deg, #0F172A 0%, #1E1B4B 100%);
    color: #FFFFFF;
    padding: 60px 0 50px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    color: #94A3B8;
    margin-bottom: 20px;
  }

  .breadcrumb a {
    color: #CBD5E1;
  }

  .breadcrumb a:hover {
    color: var(--color-electric-cyan);
  }

  .current-crumb {
    color: #FFFFFF;
    font-weight: 600;
  }

  .page-title {
    font-size: 2.4rem;
    font-weight: 800;
    color: #FFFFFF;
    margin-bottom: 14px;
  }

  .page-subtitle {
    font-size: 1.1rem;
    color: #CBD5E1;
    max-width: 780px;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 1.8rem;
    }
    .page-subtitle {
      font-size: 0.95rem;
    }
  }
</style>
