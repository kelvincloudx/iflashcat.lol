    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .cycle-selector-label {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-midnight);
  }

  .cycle-tabs {
    display: inline-flex;
    background: #E2E8F0;
    padding: 4px;
    border-radius: var(--radius-lg);
    gap: 4px;
  }

  .cycle-tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 8px 18px;
    border-radius: var(--radius-md);
    background: transparent;
    border: none;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text-dark);
    cursor: pointer;
    transition: all 0.2s ease;
    line-height: 1.2;
  }

  .cycle-tab .tab-sub {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .cycle-tab:hover {
    color: var(--color-aurora-purple);
  }

  .cycle-tab.active {
    background: #FFFFFF;
    color: var(--color-aurora-purple);
    box-shadow: var(--shadow-sm);
  }

  .cycle-tab.active .tab-sub {
    color: var(--color-aurora-purple);
  }

  .cycle-note-inline {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-align: center;
  }

  /* Regular 4 Plans Grid */
  .plans-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-bottom: 60px;
  }

  .plan-card {
    position: relative;
    background: #FFFFFF;
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    padding: 30px 24px;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .plan-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .plan-card.featured {
    border-color: var(--color-aurora-purple);
    box-shadow: 0 8px 24px rgba(124, 58, 237, 0.12);
  }

  .card-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, var(--color-aurora-purple) 0%, #6D28D9 100%);
    color: #FFFFFF;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 9999px;
    letter-spacing: 0.05em;
  }

  .card-header {
    margin-bottom: 20px;
  }

  .plan-name {
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--color-midnight);
    margin-bottom: 6px;
  }

  .plan-scenario {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    min-height: 40px;
  }

  .card-price-block {
    background: #F8FAFC;
    border-radius: var(--radius-md);
    padding: 16px;
    margin-bottom: 20px;
  }

  .price-display {
    display: flex;
    align-items: baseline;
    gap: 2px;
  }

  .currency {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-midnight);
  }

  .amount {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--color-midnight);
    line-height: 1;
  }

  .period {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    font-weight: 500;
