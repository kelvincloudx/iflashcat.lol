---
import { siteConfig } from '../data/site';
import { 
  regularPlans, 
  specialAnnualPlan, 
  annualTotalTrafficPlans,
  cycleLabels,
  type BillingCycle 
} from '../data/plans';

interface Props {
  showTitle?: boolean;
}

const { showTitle = true } = Astro.props;
---

<section id="pricing" class="section section-pricing">
  <div class="container">
    {showTitle && (
      <div class="section-header">
        <span class="section-tag">套餐方案与价格</span>
        <h2>闪电猫 SpeedCAT 公开参考套餐表</h2>
        <p>
          汇集公开网络整理的 7 种套餐规格，包含 4 档常规周期套餐、特惠小包与 2 款年度总流量套餐，涵盖全部 19 个价格选项。
        </p>
      </div>
    )}

    <!-- Regular Plans Cycle Selector -->
    <div class="pricing-controls">
      <div class="cycle-tabs-container">
        <span class="cycle-selector-label">选择常规套餐结算周期：</span>
        <div class="cycle-tabs" role="tablist" aria-label="付款周期切换">
          <button class="cycle-tab active" data-cycle="monthly" role="tab" aria-selected="true">
            月付 <span class="tab-sub">按30天结算</span>
          </button>
          <button class="cycle-tab" data-cycle="quarterly" role="tab" aria-selected="false">
            季付 <span class="tab-sub">一次付整季</span>
          </button>
          <button class="cycle-tab" data-cycle="semi-annual" role="tab" aria-selected="false">
            半年付 <span class="tab-sub">一次付半年</span>
          </button>
          <button class="cycle-tab" data-cycle="annual" role="tab" aria-selected="false">
            年付 <span class="tab-sub">一次付整年</span>
          </button>
        </div>
      </div>
      <p class="cycle-note-inline">
        注：季付、半年付、年付金额为对应周期的<strong>单次实际支付总额</strong>，非按月分摊扣费。
      </p>
    </div>

    <!-- Regular 4 Plans Cards Grid -->
    <div class="plans-grid">
      {regularPlans.map(plan => (
        <div class={`plan-card ${plan.badge ? 'featured' : ''}`} data-plan-id={plan.id}>
          {plan.badge && <span class="card-badge">{plan.badge}</span>}
          <div class="card-header">
            <h3 class="plan-name">{plan.name}</h3>
            <p class="plan-scenario">{plan.scenario}</p>
          </div>

          <div class="card-price-block">
            <div class="price-display">
              <span class="currency">¥</span>
              <span class="amount" data-price-monthly={plan.prices.monthly} data-price-quarterly={plan.prices.quarterly} data-price-semi-annual={plan.prices['semi-annual']} data-price-annual={plan.prices.annual}>
                {plan.prices.monthly}
              </span>
              <span class="period" data-period-text> / 30天（月付）</span>
            </div>
            <div class="price-desc-line" data-price-desc>
              实际支付：¥{plan.prices.monthly} / 每次
            </div>
          </div>

          <div class="card-traffic-block">
            <div class="traffic-item">
              <span class="traffic-label">流量配额：</span>
              <strong class="traffic-val">{plan.trafficLimit}</strong>
            </div>
            <div class="traffic-item">
              <span class="traffic-label">重置规则：</span>
              <span class="traffic-rule">{plan.trafficResetRule}</span>
            </div>
          </div>

          <ul class="plan-features">
            <li>
              <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span>{plan.features.lineType}</span>
            </li>
            <li>
              <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span>{plan.features.aiSupport}</span>
            </li>
            <li>
              <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span>{plan.features.mediaSupport}</span>
            </li>
            <li>
              <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span>{plan.features.nodeCoverage}</span>
            </li>
            <li>
              <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span>{plan.features.clientCompatibility}</span>
            </li>
          </ul>

          <div class="verification-badge">
            <span class="v-tag">状态说明</span>
            <span class="v-text">{plan.verificationStatus}</span>
          </div>

          <div class="card-action">
            <a 
              href={siteConfig.affUrl} 
              target={siteConfig.affTarget} 
              rel={siteConfig.affRel} 
              class={`btn ${plan.badge ? 'btn-cyan' : 'btn-outline-dark'} plan-btn`}
            >
              {siteConfig.affButtonText}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 17L17 7"/>
                <path d="M7 7h10v10"/>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Special Annual & Annual Total Volume Section -->
    <div class="special-plans-section">
      <div class="special-header">
        <h3 class="special-title">特惠年付与年度总流量方案（共3款专属规格）</h3>
        <p class="special-subtitle">针对低频备用或非月度固定清零用户的公开参考规格</p>
      </div>

      <div class="special-grid">
