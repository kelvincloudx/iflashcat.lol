            </div>
            <p class="special-rule"><strong>流量规则：</strong> {plan.trafficResetRule}</p>
            <p class="special-scenario"><strong>适用场景：</strong> {plan.scenario}</p>

            <div class="special-note-box total-note">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="16" x2="12" y2="12"/>
                <line x1="12" y1="8" x2="12.01" y2="8"/>
              </svg>
              <span>{plan.note}</span>
            </div>

            <a 
              href={siteConfig.affUrl} 
              target={siteConfig.affTarget} 
              rel={siteConfig.affRel} 
