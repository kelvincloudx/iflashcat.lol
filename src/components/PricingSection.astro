<script>
  // Dynamic switcher for regular plans
  const cycleButtons = document.querySelectorAll('.cycle-tab');
  const planCards = document.querySelectorAll('.plan-card');

  const cycleDetails: Record<string, { periodText: string; descPrefix: string }> = {
    monthly: {
      periodText: ' / 30天（月付）',
      descPrefix: '按30天单月结算，一次付 ¥'
    },
    quarterly: {
      periodText: ' / 季（季付总额）',
      descPrefix: '按季度一次性结清，实付 ¥'
    },
    'semi-annual': {
      periodText: ' / 半年（半年付总额）',
      descPrefix: '按半年一次性结清，实付 ¥'
    },
    annual: {
      periodText: ' / 年（年付总额）',
      descPrefix: '按整年一次性结清，实付 ¥'
    }
  };

  cycleButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const cycle = btn.getAttribute('data-cycle') || 'monthly';

      // Update active state
      cycleButtons.forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      // Update prices on all regular plan cards
      planCards.forEach(card => {
        const amountEl = card.querySelector('.amount') as HTMLElement;
        const periodEl = card.querySelector('[data-period-text]') as HTMLElement;
        const descEl = card.querySelector('[data-price-desc]') as HTMLElement;

        if (amountEl && periodEl && descEl) {
          let price = '0';
          if (cycle === 'monthly') price = amountEl.getAttribute('data-price-monthly') || '0';
          else if (cycle === 'quarterly') price = amountEl.getAttribute('data-price-quarterly') || '0';
          else if (cycle === 'semi-annual') price = amountEl.getAttribute('data-price-semi-annual') || '0';
          else if (cycle === 'annual') price = amountEl.getAttribute('data-price-annual') || '0';

          amountEl.textContent = price;
          const info = cycleDetails[cycle];
          if (info) {
            periodEl.textContent = info.periodText;
            descEl.textContent = `${info.descPrefix}${price}（绝非每月此价格）`;
          }
        }
      });
    });
  });
</script>

<style>
  .section-pricing {
    background-color: #F8FAFC;
    padding: 80px 0;
  }

  .disclaimer-header {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.95rem;
    font-weight: 700;
