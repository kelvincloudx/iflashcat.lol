        ))}
      </div>
    </div>

    <!-- Complete 19 Prices Verification Table (Static Accessible) -->
    <div class="static-table-section">
      <h3 class="table-section-title">全站 7 种套餐与 19 个价格选项完整汇总核对表</h3>
